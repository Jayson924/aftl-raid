# ============================================
# GOOGLE SHEETS (Legacy - current setup)
# ============================================
# Google Sheets API Key for local development
# Get this from: https://console.cloud.google.com/apis/credentials
# Note: VITE_ prefix is required for Vite to expose this to the client
VITE_GOOGLE_SHEETS_API_KEY=your-api-key-here

# ============================================
# SUPABASE (Database)
# ============================================
# Get these from your Supabase project: Settings > API
# URL: Project URL
# Anon Key: anon/public key (safe to expose in client)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# DISCORD OAUTH (Custom Auth)
# ============================================
# Get these from Discord Developer Portal > Your App > OAuth2
# Client ID is safe to expose (used in browser)
# Client Secret must stay server-side (Netlify env vars)
VITE_DISCORD_CLIENT_ID=your-discord-client-id

# Set these in Netlify Dashboard > Site settings > Environment variables
# DISCORD_CLIENT_ID=your-discord-client-id
# DISCORD_CLIENT_SECRET=your-discord-client-secret

# For migration script only (DO NOT commit this!)
# Service Role Key: service_role key (keep secret, server-side only)
# SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
